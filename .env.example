# GeoDivert API Configuration Template
# Copy this file to '.env' and fill in your personal API keys.

# 1. Google Gemini 1.5 / 2.5 Flash API Key (for live AI tour guide narratives)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. MapTiler SDK & 3D Terrain DEM Key (for 3D vector map tiles & elevation)
# Get a free key at: https://cloud.maptiler.com/account/keys/
MAPTILER_API_KEY=your_maptiler_api_key_here

# 3. OpenTripMap API Key (for cultural POI lookups)
# Get a free key at: https://opentripmap.io/product
OPENTRIPMAP_API_KEY=your_opentripmap_api_key_here

# 4. OpenAI API Key (Optional fallback model)
OPENAI_API_KEY=your_openai_api_key_here
